{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "v1__invoices",
  "operations": {
    "write": {
      "insert": {
        "request": {
          "method": "POST",
          "path": "/v1/invoices",
          "body": { "records": { "from_input": "records" } }
        },
        "input": {
          "schema": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "native_type": "string", "arrow_type": "Utf8" }
            }
          }
        },
        "batching": { "max_records": 100 }
      }
    }
  }
}
