{
  "$schema": "https://schemas.analitiq.ai/type-map/latest.json",
  "read": [
    { "match": "exact", "native_type": "BOOLEAN",                                  "arrow_type": "Boolean" },
    { "match": "exact", "native_type": "BOOL",                                     "arrow_type": "Boolean" },
    { "match": "exact", "native_type": "SMALLINT",                                 "arrow_type": "Int16" },
    { "match": "exact", "native_type": "INT2",                                     "arrow_type": "Int16" },
    { "match": "exact", "native_type": "INTEGER",                                  "arrow_type": "Int32" },
    { "match": "exact", "native_type": "INT",                                      "arrow_type": "Int32" },
    { "match": "exact", "native_type": "INT4",                                     "arrow_type": "Int32" },
    { "match": "exact", "native_type": "BIGINT",                                   "arrow_type": "Int64" },
    { "match": "exact", "native_type": "INT8",                                     "arrow_type": "Int64" },
    { "match": "exact", "native_type": "REAL",                                     "arrow_type": "Float32" },
    { "match": "exact", "native_type": "FLOAT4",                                   "arrow_type": "Float32" },
    { "match": "exact", "native_type": "DOUBLE PRECISION",                         "arrow_type": "Float64" },
    { "match": "exact", "native_type": "FLOAT8",                                   "arrow_type": "Float64" },
    { "match": "regex", "native_type": "^(?:NUMERIC|DECIMAL)\\((?<precision>[1-9]|[12]\\d|3[0-8]),\\s*(?<scale>\\d|[12]\\d|3[0-8])\\)$", "arrow_type": "Decimal128(${precision}, ${scale})" },
    { "match": "regex", "native_type": "^(?:NUMERIC|DECIMAL)\\((?<precision>39|[4-6]\\d|7[0-6]),\\s*(?<scale>\\d|[1-6]\\d|7[0-6])\\)$",   "arrow_type": "Decimal256(${precision}, ${scale})" },
    { "match": "regex", "native_type": "^(?:NUMERIC|DECIMAL)\\((?<precision>[1-9]|[12]\\d|3[0-8])\\)$",                    "arrow_type": "Decimal128(${precision}, 0)" },
    { "match": "regex", "native_type": "^(?:NUMERIC|DECIMAL)\\((?<precision>39|[4-6]\\d|7[0-6])\\)$",                      "arrow_type": "Decimal256(${precision}, 0)" },
    { "match": "regex", "native_type": "^(?:NUMERIC|DECIMAL)$",                                                            "arrow_type": "Decimal128(38, 9)" },
    { "match": "exact", "native_type": "TEXT",                                     "arrow_type": "Utf8" },
    { "match": "regex", "native_type": "^CHARACTER VARYING(\\(.+\\))?$",           "arrow_type": "Utf8" },
    { "match": "regex", "native_type": "^VARCHAR(\\(.+\\))?$",                     "arrow_type": "Utf8" },
    { "match": "regex", "native_type": "^CHARACTER(\\(.+\\))?$",                   "arrow_type": "Utf8" },
    { "match": "regex", "native_type": "^CHAR(\\(.+\\))?$",                        "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "BPCHAR",                                   "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "UUID",                                     "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "JSON",                                     "arrow_type": "Json" },
    { "match": "exact", "native_type": "JSONB",                                    "arrow_type": "Json" },
    { "match": "exact", "native_type": "XML",                                      "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "BYTEA",                                    "arrow_type": "Binary" },
    { "match": "exact", "native_type": "DATE",                                     "arrow_type": "Date32" },
    { "match": "regex", "native_type": "^TIME\\(0\\)( WITHOUT TIME ZONE)?$",       "arrow_type": "Time32(SECOND)" },
    { "match": "regex", "native_type": "^TIME\\([1-3]\\)( WITHOUT TIME ZONE)?$",   "arrow_type": "Time32(MILLISECOND)" },
    { "match": "regex", "native_type": "^TIME(\\([4-6]\\))?( WITHOUT TIME ZONE)?$","arrow_type": "Time64(MICROSECOND)" },
    { "match": "regex", "native_type": "^TIME\\(0\\) WITH TIME ZONE$",             "arrow_type": "Time32(SECOND)" },
    { "match": "regex", "native_type": "^TIME\\([1-3]\\) WITH TIME ZONE$",         "arrow_type": "Time32(MILLISECOND)" },
    { "match": "regex", "native_type": "^TIME(\\([4-6]\\))? WITH TIME ZONE$",      "arrow_type": "Time64(MICROSECOND)" },
    { "match": "exact", "native_type": "TIMETZ",                                   "arrow_type": "Time64(MICROSECOND)" },
    { "match": "regex", "native_type": "^TIMESTAMP\\(0\\)( WITHOUT TIME ZONE)?$",       "arrow_type": "Timestamp(SECOND)" },
    { "match": "regex", "native_type": "^TIMESTAMP\\([1-3]\\)( WITHOUT TIME ZONE)?$",   "arrow_type": "Timestamp(MILLISECOND)" },
    { "match": "regex", "native_type": "^TIMESTAMP(\\([4-6]\\))?( WITHOUT TIME ZONE)?$","arrow_type": "Timestamp(MICROSECOND)" },
    { "match": "regex", "native_type": "^TIMESTAMP\\(0\\) WITH TIME ZONE$",             "arrow_type": "Timestamp(SECOND, UTC)" },
    { "match": "regex", "native_type": "^TIMESTAMP\\([1-3]\\) WITH TIME ZONE$",         "arrow_type": "Timestamp(MILLISECOND, UTC)" },
    { "match": "regex", "native_type": "^TIMESTAMP(\\([4-6]\\))? WITH TIME ZONE$",      "arrow_type": "Timestamp(MICROSECOND, UTC)" },
    { "match": "exact", "native_type": "TIMESTAMPTZ",                                   "arrow_type": "Timestamp(MICROSECOND, UTC)" },
    { "match": "exact", "native_type": "INTERVAL",                                 "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "INET",                                     "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "CIDR",                                     "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "MACADDR",                                  "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "MACADDR8",                                 "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "MONEY",                                    "arrow_type": "Utf8" },
    { "match": "exact", "native_type": "ARRAY",                                    "arrow_type": "Json" },
    { "match": "regex", "native_type": ".*\\[\\]$",                                "arrow_type": "Json" }
  ],
  "write": [
    {
      "match": "exact",
      "arrow_type": "Boolean",
      "native_type": "BOOLEAN"
    },
    {
      "match": "exact",
      "arrow_type": "Int8",
      "native_type": "SMALLINT"
    },
    {
      "match": "exact",
      "arrow_type": "Int16",
      "native_type": "SMALLINT"
    },
    {
      "match": "exact",
      "arrow_type": "Int32",
      "native_type": "INTEGER"
    },
    {
      "match": "exact",
      "arrow_type": "Int64",
      "native_type": "BIGINT"
    },
    {
      "match": "exact",
      "arrow_type": "UInt8",
      "native_type": "SMALLINT"
    },
    {
      "match": "exact",
      "arrow_type": "UInt16",
      "native_type": "INTEGER"
    },
    {
      "match": "exact",
      "arrow_type": "UInt32",
      "native_type": "BIGINT"
    },
    {
      "match": "exact",
      "arrow_type": "UInt64",
      "native_type": "BIGINT"
    },
    {
      "match": "exact",
      "arrow_type": "Float16",
      "native_type": "REAL"
    },
    {
      "match": "exact",
      "arrow_type": "Float32",
      "native_type": "REAL"
    },
    {
      "match": "exact",
      "arrow_type": "Float64",
      "native_type": "DOUBLE PRECISION"
    },
    {
      "match": "regex",
      "arrow_type": "^Decimal(128|256)\\((?<p>\\d+),\\s*(?<s>\\d+)\\)$",
      "native_type": "NUMERIC(${p}, ${s})"
    },
    {
      "match": "exact",
      "arrow_type": "Utf8",
      "native_type": "TEXT"
    },
    {
      "match": "exact",
      "arrow_type": "LargeUtf8",
      "native_type": "TEXT"
    },
    {
      "match": "exact",
      "arrow_type": "Json",
      "native_type": "JSONB"
    },
    {
      "match": "exact",
      "arrow_type": "Object",
      "native_type": "JSONB"
    },
    {
      "match": "exact",
      "arrow_type": "List",
      "native_type": "JSONB"
    },
    {
      "match": "exact",
      "arrow_type": "Binary",
      "native_type": "BYTEA"
    },
    {
      "match": "exact",
      "arrow_type": "LargeBinary",
      "native_type": "BYTEA"
    },
    {
      "match": "regex",
      "arrow_type": "^FixedSizeBinary\\(\\d+\\)$",
      "native_type": "BYTEA"
    },
    {
      "match": "exact",
      "arrow_type": "Date32",
      "native_type": "DATE"
    },
    {
      "match": "exact",
      "arrow_type": "Date64",
      "native_type": "DATE"
    },
    {
      "match": "regex",
      "arrow_type": "^Time(32|64)\\([A-Z]+\\)$",
      "native_type": "TIME"
    },
    {
      "match": "regex",
      "arrow_type": "^Timestamp\\([A-Z]+\\)$",
      "native_type": "TIMESTAMP"
    },
    {
      "match": "regex",
      "arrow_type": "^Timestamp\\([A-Z]+,\\s*UTC\\)$",
      "native_type": "TIMESTAMPTZ"
    },
    {
      "match": "regex",
      "arrow_type": "^Duration\\([A-Z]+\\)$",
      "native_type": "INTERVAL"
    },
    {
      "match": "exact",
      "arrow_type": "Null",
      "native_type": "TEXT"
    }
  ]
}
