{
  "$defs": {
    "TypeMapReadExactRule": {
      "additionalProperties": false,
      "description": "Read exact rule: literal `native_type` matches, literal Arrow `arrow_type` renders.",
      "properties": {
        "arrow_type": {
          "minLength": 1,
          "pattern": "^(?:Binary|Boolean|Date32|Date64|Decimal128\\((?:[1-9]|1[0-9]|2[0-9]|3[0-8])\\s*,\\s*(?:[0-9]|1[0-9]|2[0-9]|3[0-8])\\)|Decimal256\\((?:[1-9]|1[0-9]|2[0-9]|3[0-9]|4[0-9]|5[0-9]|6[0-9]|7[0-6])\\s*,\\s*(?:[0-9]|1[0-9]|2[0-9]|3[0-9]|4[0-9]|5[0-9]|6[0-9]|7[0-6])\\)|Duration\\((?:SECOND|MILLISECOND|MICROSECOND|NANOSECOND)\\)|FixedSizeBinary\\([1-9][0-9]*\\)|Float16|Float32|Float64|Int16|Int32|Int64|Int8|Json|LargeBinary|LargeUtf8|List|Null|Object|Time32\\((?:SECOND|MILLISECOND)\\)|Time64\\((?:MICROSECOND|NANOSECOND)\\)|Timestamp\\((?:SECOND|MILLISECOND|MICROSECOND|NANOSECOND)(?:\\s*,\\s*(?:null|[A-Za-z_][A-Za-z0-9_\\/\\-]*|Etc\\/GMT[+\\-][0-9]{1,2}|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]))?\\)|UInt16|UInt32|UInt64|UInt8|Utf8)$",
          "title": "Arrow Type",
          "type": "string"
        },
        "match": {
          "const": "exact",
          "title": "Match",
          "type": "string"
        },
        "native_type": {
          "minLength": 1,
          "title": "Native Type",
          "type": "string"
        }
      },
      "required": [
        "native_type",
        "arrow_type",
        "match"
      ],
      "title": "TypeMapReadExactRule",
      "type": "object"
    },
    "TypeMapReadRegexRule": {
      "additionalProperties": false,
      "description": "Read regex rule: ECMA-262 `native_type` matches, Arrow `arrow_type` render template\n(its `${name}` placeholders draw from the `native_type`'s named captures).",
      "properties": {
        "arrow_type": {
          "minLength": 1,
          "title": "Arrow Type",
          "type": "string"
        },
        "match": {
          "const": "regex",
          "title": "Match",
          "type": "string"
        },
        "native_type": {
          "minLength": 1,
          "title": "Native Type",
          "type": "string"
        }
      },
      "required": [
        "native_type",
        "arrow_type",
        "match"
      ],
      "title": "TypeMapReadRegexRule",
      "type": "object"
    },
    "TypeMapWriteExactRule": {
      "additionalProperties": false,
      "description": "Write exact rule: literal Arrow `arrow_type` matches, `native_type` DDL renders.",
      "properties": {
        "arrow_type": {
          "minLength": 1,
          "pattern": "^(?:Binary|Boolean|Date32|Date64|Decimal128\\((?:[1-9]|1[0-9]|2[0-9]|3[0-8])\\s*,\\s*(?:[0-9]|1[0-9]|2[0-9]|3[0-8])\\)|Decimal256\\((?:[1-9]|1[0-9]|2[0-9]|3[0-9]|4[0-9]|5[0-9]|6[0-9]|7[0-6])\\s*,\\s*(?:[0-9]|1[0-9]|2[0-9]|3[0-9]|4[0-9]|5[0-9]|6[0-9]|7[0-6])\\)|Duration\\((?:SECOND|MILLISECOND|MICROSECOND|NANOSECOND)\\)|FixedSizeBinary\\([1-9][0-9]*\\)|Float16|Float32|Float64|Int16|Int32|Int64|Int8|Json|LargeBinary|LargeUtf8|List|Null|Object|Time32\\((?:SECOND|MILLISECOND)\\)|Time64\\((?:MICROSECOND|NANOSECOND)\\)|Timestamp\\((?:SECOND|MILLISECOND|MICROSECOND|NANOSECOND)(?:\\s*,\\s*(?:null|[A-Za-z_][A-Za-z0-9_\\/\\-]*|Etc\\/GMT[+\\-][0-9]{1,2}|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]))?\\)|UInt16|UInt32|UInt64|UInt8|Utf8)$",
          "title": "Arrow Type",
          "type": "string"
        },
        "match": {
          "const": "exact",
          "title": "Match",
          "type": "string"
        },
        "native_type": {
          "minLength": 1,
          "title": "Native Type",
          "type": "string"
        }
      },
      "required": [
        "native_type",
        "arrow_type",
        "match"
      ],
      "title": "TypeMapWriteExactRule",
      "type": "object"
    },
    "TypeMapWriteRegexRule": {
      "additionalProperties": false,
      "description": "Write regex rule: ECMA-262 `arrow_type` matches, `native_type` DDL render template.\n`arrow_type` is the matcher here, so it is NOT held to the Arrow vocabulary.",
      "properties": {
        "arrow_type": {
          "minLength": 1,
          "title": "Arrow Type",
          "type": "string"
        },
        "match": {
          "const": "regex",
          "title": "Match",
          "type": "string"
        },
        "native_type": {
          "minLength": 1,
          "title": "Native Type",
          "type": "string"
        }
      },
      "required": [
        "native_type",
        "arrow_type",
        "match"
      ],
      "title": "TypeMapWriteRegexRule",
      "type": "object"
    }
  },
  "$id": "https://schemas.analitiq.ai/type-map/1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "read": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "read"
      ]
    },
    {
      "properties": {
        "write": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "write"
      ]
    }
  ],
  "description": "Public JSON Schema contract for a connector's or connection's `type-map.json` \u2014 a top-level object carrying, keyed by direction, an ordered, non-empty rule list: `read` rules match a `native_type` and render an `arrow_type`, `write` rules match an `arrow_type` and render a `native_type`; order is significant (first match wins) and at least one direction is present. The full per-rule contract (matcher dialect, `${name}` capture correspondence, Arrow vocabulary, schemaless-container handling) lives in the model and is enforced by the connector validator; this published schema is the structural projection. Source of truth: analitiq.contracts.type_map.TypeMapDoc (Pydantic).",
  "properties": {
    "$schema": {
      "const": "https://schemas.analitiq.ai/type-map/latest.json",
      "description": "Schema URL declared by every `type-map.json` document.",
      "title": "$Schema",
      "type": "string"
    },
    "read": {
      "anyOf": [
        {
          "items": {
            "discriminator": {
              "mapping": {
                "exact": "#/$defs/TypeMapReadExactRule",
                "regex": "#/$defs/TypeMapReadRegexRule"
              },
              "propertyName": "match"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TypeMapReadExactRule"
              },
              {
                "$ref": "#/$defs/TypeMapReadRegexRule"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Read rules: each matches a `native_type` and renders an `arrow_type`.",
      "title": "Read"
    },
    "write": {
      "anyOf": [
        {
          "items": {
            "discriminator": {
              "mapping": {
                "exact": "#/$defs/TypeMapWriteExactRule",
                "regex": "#/$defs/TypeMapWriteRegexRule"
              },
              "propertyName": "match"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TypeMapWriteExactRule"
              },
              {
                "$ref": "#/$defs/TypeMapWriteRegexRule"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Write rules: each matches an `arrow_type` and renders a `native_type`.",
      "title": "Write"
    }
  },
  "required": [
    "$schema"
  ],
  "title": "Analitiq Type Map",
  "type": "object",
  "version": "1.0.0"
}
