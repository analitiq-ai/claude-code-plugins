{
  "request": {
    "method": "GET",
    "path": "/items",
    "query": {
      "since": {
        "from_param": "since"
      },
      "until": {
        "from_param": "until"
      }
    }
  },
  "params": {
    "since": {
      "in": "query",
      "type": "string",
      "required": false,
      "controlled_by": "replication"
    },
    "until": {
      "in": "query",
      "type": "string",
      "required": false,
      "controlled_by": "replication"
    }
  },
  "response": {
    "schema": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "updated_at": {
                "type": "integer",
                "format": "epoch_milliseconds"
              }
            }
          }
        }
      }
    },
    "records": {
      "ref": "response.body.records"
    }
  },
  "replication": {
    "supported_methods": [
      "full_refresh",
      "incremental"
    ],
    "cursor_mappings": [
      {
        "cursor_field": "updated_at",
        "start_param": "since",
        "end_param": "until",
        "start_operator": "gte",
        "end_operator": "lt"
      }
    ]
  }
}
