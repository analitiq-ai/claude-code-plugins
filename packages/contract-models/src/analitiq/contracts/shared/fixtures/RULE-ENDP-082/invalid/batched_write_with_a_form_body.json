{
  "request": {
    "method": "POST",
    "path": "/items",
    "content_type": "application/x-www-form-urlencoded",
    "body": {
      "items": {
        "from_input": "records"
      }
    }
  },
  "batching": {
    "max_records": 50
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "native_type": "integer",
          "arrow_type": "Int64"
        }
      }
    }
  }
}
