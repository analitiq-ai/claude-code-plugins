{
  "transport_type": "http",
  "base_url": "https://api.example.test/v1",
  "headers": {
    "Authorization": {
      "function": "basic_auth",
      "input": {
        "username": {
          "ref": "connection.parameters.username"
        },
        "password": {
          "ref": "secrets.password"
        }
      }
    }
  }
}
